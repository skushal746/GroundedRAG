# ---- Service ----
# Comma-separated keys accepted in the X-API-Key header. CHANGE THIS.
API_KEYS=dev-key-change-me
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20

# ---- Database ----
# Used by local tools (eval, tests, alembic). docker-compose overrides it for the api container.
DATABASE_URL=postgresql+asyncpg://groundedrag:groundedrag@localhost:5433/groundedrag
DB_POOL_SIZE=5

# ---- LLM ----
# openai | anthropic | fake (offline stub for demos/tests)
LLM_PROVIDER=openai
# Empty = provider default (openai: gpt-4.1-mini, anthropic: claude-sonnet-5-5)
LLM_MODEL=
# Leave empty for models that only accept the default temperature
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_S=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings ----
# local (sentence-transformers) | openai | fake
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's output size AND the pgvector column (set before first migration)
EMBEDDING_DIM=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Chunking ----
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# ---- Retrieval ----
# vector | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
FINAL_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Confidence gate: skip the LLM if the best rerank score is below this (see README)
MIN_RERANK_SCORE=0.0001

# ---- Conversation ----
# Number of previous user/assistant exchanges used for query rewriting
HISTORY_TURNS=3
FALLBACK_MESSAGE=I'm sorry, I couldn't find a reliable answer to that in our help documentation. Would you like me to connect you with a member of our support team?
